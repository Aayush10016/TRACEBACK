# Loaded by scripts/start-backend.ps1; never use VITE_* for secrets.
META_API_KEY=
META_MODEL=muse-spark-1.3
META_PROVIDER=meta
META_ENDPOINT=https://api.meta.ai/v1/chat/completions
# Used only by the postgres profile. Set a real local password; do not commit it.
DB_URL=jdbc:postgresql://localhost:5432/traceback
DB_USER=traceback
DB_PASSWORD=replace-with-local-password

# NVIDIA-hosted Meta model (alternative to direct Meta API)
AI_PROVIDER=meta
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/muse-glimmer-30b
